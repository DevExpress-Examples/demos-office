<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DevExpress.Document.Processor" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\..\Documents\PDF\Sample_Alternative.pdf">
			<Link>Documents\PDF\Sample_Alternative.pdf</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\..\Documents\PDF\Sample_Certificate.pfx">
			<Link>Documents\PDF\Sample_Certificate.pfx</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\..\Documents\PDF\Signature_Background.png">
			<Link>Documents\PDF\Signature_Background.png</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\..\Documents\DevExpress.png">
			<Link>Documents\DevExpress.png</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
