@inherits ComponentBase

<CascadingValue Value="this">
    @ChildContent
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <div class="nav-link bg-light text-dark">C#</div>
                </li>
            </ul>
            <button class="btn btn-sm btn-secondary copy-code"><span class="icon icon-copy"></span><span>Copy</span></button>
        </div>
        <div class="card-body code-container">
            <pre>
                <PageSectionCodeSnippet>@singleTabPage?.ChildContent</PageSectionCodeSnippet>
            </pre>
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    PageSectionCodeSnippetTabPage singleTabPage;


    public void AddTabPage(ComponentBase tabPage) {
        if (singleTabPage != null)
            throw new InvalidOperationException("Only one tab page is supported in current implementation");
        PageSectionCodeSnippetTabPage currentTabPage = (PageSectionCodeSnippetTabPage)tabPage;
        if (currentTabPage.Language == "csharp")
            singleTabPage = currentTabPage;
        StateHasChanged();
    }
}
