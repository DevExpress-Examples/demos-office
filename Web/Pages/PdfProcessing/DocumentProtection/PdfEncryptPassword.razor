@page "/PdfProcessing/DocumentProtection/PdfEncryptPassword"
@using BlazorDemo.OfficeFileApi.Models.PdfProcessing.DocumentProtection
@inherits DemoPageComponentWithValidation<PdfEncryptPasswordModel>

@namespace BlazorDemo.OfficeFileApi.Pages.PdfProcessing

<DemoPageMainLayout Loading="@loading"
                    EditFormContext="@editFormContext"
                    AdvancedOptionsZoneCaption="Document Permission Settings">
    <DocumentZoneLayoutItem>
        <DemoUploader @ref="fileUploadRef"
                      AllowedFileExtensions="@model.AllowedFileExtensions"
                      DefaultDocument="@DemoDocumentPaths.PdfSample" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Owner Password"
                          ColSpanMd="4">
            <DxTextBox @bind-Text="model.OwnerPassword"
                       Password="true"
                       NullText="Enter secure password"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="User Password"
                          ColSpanMd="4">
            <DxTextBox @bind-Text="model.UserPassword"
                       Password="true"
                       NullText="Enter secure password"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Encryption Algorithm"
                          ColSpanMd="4">
            <DxComboBox Data="@model.EncryptionAlgorithms"
                        @bind-Value="model.EncryptionAlgorithm"
                        Placeholder="Select encryption algorithm"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Data Extraction Permissions"
                          ColSpanMd="4">
            <DxComboBox Data="@model.DocumentDataExtractionPermissionsCollection"
                        @bind-Value="model.DocumentDataExtractionPermissions"
                        Enabled="!string.IsNullOrEmpty(model.OwnerPassword)"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Interactivity Permissions"
                          ColSpanMd="4">
            <DxComboBox Data="@model.DocumentInteractivityPermissionsCollection"
                        @bind-Value="model.DocumentInteractivityPermissions"
                        Enabled="!string.IsNullOrEmpty(model.OwnerPassword)"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Modification Permissions"
                          ColSpanMd="4">
            <DxComboBox Data="@model.DocumentModificationPermissionsCollection"
                        @bind-Value="model.DocumentModificationPermissions"
                        Enabled="!string.IsNullOrEmpty(model.OwnerPassword)"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Printing Permissions"
                          ColSpanMd="4">
            <DxComboBox Data="@model.DocumentPrintingPermissionsCollection"
                        @bind-Value="model.DocumentPrintingPermissions"
                        Enabled="!string.IsNullOrEmpty(model.OwnerPassword)"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DownloadButton @ref="downloadButton"
                        Text="Encrypt Document"
                        Click="() => ProcessDownloadWithLoading(Process)"
                        Enabled="!string.IsNullOrEmpty(model.OwnerPassword)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>


@code {
    async Task Process() {
        // Create multipart form data
        using var content = CreateMultipartContent();
        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        // Add form parameters from model
        if (model.OwnerPassword != null)
            content.Add(new StringContent(model.OwnerPassword), "OwnerPassword");
        if (model.UserPassword != null)
            content.Add(new StringContent(model.UserPassword), "UserPassword");
        content.Add(new StringContent(model.EncryptionAlgorithm.ToString()), "EncryptionAlgorithm");
        content.Add(new StringContent(model.DocumentDataExtractionPermissions.ToString()), "DocumentDataExtractionPermissions");
        content.Add(new StringContent(model.DocumentInteractivityPermissions.ToString()), "DocumentInteractivityPermissions");
        content.Add(new StringContent(model.DocumentModificationPermissions.ToString()), "DocumentModificationPermissions");
        content.Add(new StringContent(model.DocumentPrintingPermissions.ToString()), "DocumentPrintingPermissions");

        // Call controller API
        var apiUrl = "api/pdfprocessing/document-protection/encrypt-password";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat.ToString());
    }
}
