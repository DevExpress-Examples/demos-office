@page "/SpreadsheetProcessing/DocumentProtection/ProtectWorkbook"
@using BlazorDemo.OfficeFileApi.Models.Spreadsheet.DocumentProtection
@inherits DemoPageComponentWithValidation<ExcelProtectWorkbookModel>
<EditForm Model="@model" OnValidSubmit="@ProcessDownload" Context="buttonCtx">
    <DataAnnotationsValidator />
    <DemoPageMainLayout Loading="@loading"
                        EditFormContext="@editFormContext"
                        AdvancedOptionsZoneCaption="Protection Settings">
        <DocumentZoneLayoutItem>
            <DemoUploader @ref="fileUploadRef"
                          AllowedFileExtensions="@model.AllowedFileExtensions"
                          DefaultDocument="@DemoDocumentPaths.SpreadsheetSample" />
        </DocumentZoneLayoutItem>
        <MainOptionsZoneLayoutGroup>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Workbook Password" ColSpanMd="4">
                <DxTextBox @bind-Text="model.WorkbookPassword"
                           Placeholder="Enter workbook password"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        </MainOptionsZoneLayoutGroup>
        <AdvancedOptionsZoneLayoutGroup>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.LockStructure"
                            T="bool">
                    Lock Structure
                </DxCheckBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.LockWindows"
                            T="bool">
                    Lock Windows
                </DxCheckBox>
            </DxFormLayoutItem>
        </AdvancedOptionsZoneLayoutGroup>
        <ButtonZoneLayoutItem>
            <DropDownDownloadButton @ref="downloadButton"
                                    Text="Protect and Save as "
                                    Data="@model.OutputFormats"
                                    @bind-Value="model.OutputFormat"
                                    Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
        </ButtonZoneLayoutItem>
    </DemoPageMainLayout>
</EditForm>

@code {
    async Task ProcessDownload() {
        using var content = CreateMultipartContent();
        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        // Add form parameters from model
        content.Add(new StringContent(model.WorkbookPassword ?? string.Empty), "WorkbookPassword");
        content.Add(new StringContent(model.LockStructure.ToString()), "LockStructure");
        content.Add(new StringContent(model.LockWindows.ToString()), "LockWindows");

        var apiUrl = "api/spreadsheetprocessing/protect-password/protect-workbook";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}
