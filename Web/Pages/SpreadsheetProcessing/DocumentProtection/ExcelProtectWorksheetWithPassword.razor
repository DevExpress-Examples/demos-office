@page "/SpreadsheetProcessing/DocumentProtection/ProtectWorksheet"
@using BlazorDemo.OfficeFileApi.Models.Spreadsheet.DocumentProtection
@inherits DemoPageComponentWithValidation<ExcelProtectWorksheetModel>
@using DevExpress.Spreadsheet

<EditForm Model="@model" OnValidSubmit="@ProcessDownload" Context="buttonCtx">
    <DataAnnotationsValidator />
    <DemoPageMainLayout Loading="@loading"
                        EditFormContext="@editFormContext"
                        AdvancedOptionsZoneCaption="Protection Settings">
        <DocumentZoneLayoutItem>
            <DemoUploader @ref="fileUploadRef"
                          AllowedFileExtensions="@model.AllowedFileExtensions"
                          DefaultDocument="@DemoDocumentPaths.SpreadsheetSample" />
        </DocumentZoneLayoutItem>
        <MainOptionsZoneLayoutGroup>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Worksheet Password" ColSpanMd="4">
                <DxTextBox @bind-Text="model.WorksheetPassword"
                           Placeholder="Enter worksheet password"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Protection Permissions" ColSpanMd="8">
                <DxTagBox @bind-Values="model.SelectedWorksheetProtectionPermissions"
                          TData="EnumWrapper<WorksheetProtectionPermissions>"
                          TValue="WorksheetProtectionPermissions"
                          ValueFieldName="Value"
                          TextFieldName="DisplayName"
                          Data="model.WorksheetPermissions">
                </DxTagBox>
            </DxFormLayoutItem>
        </MainOptionsZoneLayoutGroup>
        <AdvancedOptionsZoneLayoutGroup>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Sheet Protection Mode" ColSpanMd="4">
                <DxComboBox Data="@model.SheetProtectionModes" @bind-Value="model.SheetProtectionMode"
                            TextFieldName="Text"
                            ValueFieldName="Value"
                            Placeholder="Sheet protection mode" />
            </DxFormLayoutItem>
        </AdvancedOptionsZoneLayoutGroup>
        <ButtonZoneLayoutItem>
            <DropDownDownloadButton @ref="downloadButton"
                                    Text="Protect and Save as "
                                    Data="@model.OutputFormats"
                                    @bind-Value="model.OutputFormat"
                                    Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
        </ButtonZoneLayoutItem>
    </DemoPageMainLayout>
</EditForm>

@code {
    async Task ProcessDownload() {
        using var content = CreateMultipartContent();
        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        // Add form parameters from model
        content.Add(new StringContent(model.WorksheetPassword ?? string.Empty), "WorksheetPassword");
        content.Add(new StringContent(model.SheetProtectionMode.ToString()), "SheetProtectionMode");

        foreach (var permission in model.SelectedWorksheetProtectionPermissions) {
            content.Add(new StringContent(permission.ToString()), "SelectedWorksheetProtectionPermissions");
        }

        var apiUrl = "api/spreadsheetprocessing/protect-password/protect-worksheet";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}
