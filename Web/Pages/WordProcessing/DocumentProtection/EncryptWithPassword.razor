@page "/WordProcessing/DocumentProtection/EncryptWithPassword"
@using BlazorDemo.OfficeFileApi.Models.WordProcessing.DocumentProtection
@inherits DemoPageComponentWithValidation<WordEncryptPasswordModel>

@namespace BlazorDemo.OfficeFileApi.Pages.WordProcessing

<DemoPageMainLayout Loading="@loading"
                    EditFormContext="@editFormContext">
    <DocumentZoneLayoutItem>
        <DemoUploader @ref="fileUploadRef"
                      AllowedFileExtensions="@model.AllowedFileExtensions"
                      DefaultDocument="@DemoDocumentPaths.WordSample" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Password" ColSpanMd="4">
            <DxTextBox @bind-Text="model.Password"
                       Password="true"
                       Placeholder="Enter secure password"
                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Encryption Type" ColSpanMd="4">
            <DxComboBox Data="@model.EncryptionTypes" @bind-Value="model.EncryptionType"
                        TextFieldName="Text" ValueFieldName="Value"
                        Placeholder="Select encryption type" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Encrypt and Save as "
                                Data="@model.OutputFormats"
                                @bind-Value="model.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>


@code {
    async Task ProcessDownload() {
        using var content = CreateMultipartContent();
        content.Add(new StringContent(model.Password), "Password");
        content.Add(new StringContent(model.EncryptionType.ToString()), "EncryptionType");
        AddCommonParameters(content, model.OutputFormat, model.OutputName);
        var apiUrl = "api/wordprocessing/encrypt-password/encrypt";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}


