@page "/WordProcessing"

<div id="doc" class="markdown-body container-fluid overview-page">
  <h1>DevExpress Word Processing Document API</h1>
  <p>The <a href="https://docs.devexpress.com/OfficeFileAPI/17488/word-processing-document-api" target="_blank" rel="noopener">DevExpress Word Processing Document API</a> is a non-visual .NET library that allows you to generate and process Microsoft® Word® documents across multiple platforms and operating systems. This library helps you automate such common tasks as file conversion, text formatting, document protection, mail merge, printing, and export to PDF/HTML.</p>
  <h2>Get Started</h2>
  <h3>Install the <a href="https://www.nuget.org/packages/DevExpress.Document.Processor" target="_blank" rel="noopener">DevExpress.Document.Processor NuGet</a> package</h3>
  <CodeSnippet Label="CLI" Language="language-bash" Code="@InstallPackageCode"/>

  <h3>Code Example - Load a Word file and Export to PDF</h3>
  <CodeSnippet Label="C#" Language="language-csharp" Code="@ExportToPdfCode"/>

  <h3>Code Example - Load a Word file and Add Text Watermark</h3>
  <CodeSnippet Label="C#" Language="language-csharp" Code="@AddWatermarkCode"/>

  <h2>File Format Support</h2>
  <ul>
    <li>Import/Export: <strong>TXT, DOC, RTF, DOCX, DOCM, DOT, DOTX, DOTM, ODT, EPUB, HTML</strong></li>
    <li>Export Only: <strong>PDF, Image Formats (BMP, PNG, JPEG, EMF, WMF, SVG)</strong></li>
  </ul>

  <h2 id="Key-Features">Key Features</h2>
  <p>The DevExpress Word Processing Document API allows you to manage rich text documents:</p>
  <ul>
    <li>Generate or edit document content</li>
    <li>Specify character and paragraph formatting</li>
    <li>Password-protect and encrypt documents</li>
    <li>Use Mail Merge to create personalized messages and reports</li>
    <li>Compare Word files</li>
    <li>Print, convert, and export</li>
    <li>And much more</li>
  </ul>

  <h2>Learning Materials</h2>
  <ul>
    <li><a href="https://www.devexpress.com/products/net/office-file-api/word/" target="_blank" rel="noopener">DevExpress Word Processing Document API - Home Page</a></li>
    <li><a href="https://docs.devexpress.com/OfficeFileAPI/17488/word-processing-document-api" target="_blank" rel="noopener">DevExpress Word Processing Document API - Documentation</a></li>
    <li><a href="https://github.com/orgs/DevExpress-Examples/repositories?q=word-processing" target="_blank" rel="noopener">DevExpress Word Processing Document API - GitHub Examples</a></li>
    <li><a href="https://community.devexpress.com/Tags/Office" target="_blank" rel="noopener">DevExpress Office File API - Blogs</a></li>
  </ul>
</div>

@code {
  static string InstallPackageCode = @"dotnet add package DevExpress.Document.Processor";

  static string ExportToPdfCode = @"
using DevExpress.XtraRichEdit;
using DevExpress.XtraRichEdit.API.Native;

using var wordProcessor = new RichEditDocumentServer();
wordProcessor.LoadDocument(""wordFile.docx"");
MemoryStream docStream1 = new MemoryStream();
wordProcessor.ExportToPdf(docStream1);
docStream1.Position = 0;
".TrimStart().TrimEnd();

  static string AddWatermarkCode = @"
using DevExpress.XtraRichEdit;
using DevExpress.XtraRichEdit.API.Native;

using var wordProcessor = new RichEditDocumentServer();
Document document = wordProcessor.Document;
document.LoadDocument(@""Watermarks.docx"");

// Define text watermark options.
TextWatermarkOptions textWatermarkOptions = new TextWatermarkOptions();
textWatermarkOptions.Color = System.Drawing.Color.LightGray;
textWatermarkOptions.FontFamily = ""Calibri"";
textWatermarkOptions.Layout = WatermarkLayout.Diagonal;
textWatermarkOptions.Semitransparent = true;

// Add a text watermark to the document.
document.WatermarkManager.SetText(""CONFIDENTIAL"", textWatermarkOptions);

document.SaveDocument(""WatermarksUpd.docx"", DocumentFormat.Docx);
".TrimStart().TrimEnd();
}
