@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using BlazorDemo.OfficeFileApi.Models
@using BlazorDemo.OfficeFileApi.Models.WordProcessing.DocumentConversion
@implements IAsyncDisposable

<div class="file-list">
    @foreach (var defaultFileInfo in DefaultFileInfoList) {
        <div class="file-item">
            <div class="file-info">
                <svg class="dxbl-image dxbl-btn-icon" aria-hidden="true" focusable="false"><use class="dxbl-icon-set-default" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-file"></use><use class="dxbl-icon-set-fluent" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-file-fluent"></use><use class="dxbl-icon-set-fluent-small" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-file-fluent-16"></use><use class="dxbl-icon-set-fluent-large" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-file-fluent-24"></use></svg>
                <span class="padding: 0 var(--uploader-item-layout-inner-box-medium-horizontal, 8px);">@Path.GetFileName(defaultFileInfo.Name)</span>
            </div>
            <svg class="dxbl-image dxbl-btn-icon file-download" @onclick="() => DownloadDefaultDocument(defaultFileInfo)" style="transform: rotate(180deg);" aria-hidden="true" focusable="false"><use class="dxbl-icon-set-default" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-upload"></use><use class="dxbl-icon-set-fluent" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-upload-fluent"></use><use class="dxbl-icon-set-fluent-small" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-upload-fluent-16"></use><use class="dxbl-icon-set-fluent-large" href="_content/DevExpress.Blazor/dx-blazor.svg#dx-uc-upload-fluent-24"></use></svg>
        </div>            
    }
</div>

@code {
    IJSObjectReference downloadDocumentJsModule;
    // Parameters
    [Parameter] public List<string> DefaultDocuments { get; set; } = new List<string>();

    public List<DefaultFileInfo> DefaultFileInfoList = new List<DefaultFileInfo>();

    protected override void OnInitialized() {
        foreach (var document in DefaultDocuments)
            DefaultFileInfoList?.Add(new DefaultFileInfo(document, File.ReadAllBytes(document)));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender)
            downloadDocumentJsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Shared/DefaultFileBase.razor.js");
    }

    async Task DownloadDefaultDocument(DefaultFileInfo fileInfo) {
        if (downloadDocumentJsModule is null) {
            Console.WriteLine("Can't download file ./Shared/DefaultFileBase.razor.js: JavaScript module is not initialized.");
            return;
        }
        var currentFileBytes = fileInfo.Content;
        if (currentFileBytes?.Length > 0) {
            using DotNetStreamReference streamRef = new(new MemoryStream(currentFileBytes));
            await downloadDocumentJsModule!.InvokeVoidAsync("downloadFileFromStream", Path.GetFileName(fileInfo.Name), streamRef);
        } else
            Console.WriteLine("Can't download file");
    }

    public async ValueTask DisposeAsync() {
        if (downloadDocumentJsModule == null)
            await ValueTask.CompletedTask;
        else
            await downloadDocumentJsModule.DisposeAsync();
    }
}
